const express = require('express');
const bcrypt = require('bcrypt');
const session = require('express-session');
const path = require('path');
const bodyParser = require('body-parser');

const app = express();
const PORT = 3000;

// In-memory user store (replace with MongoDB later)
const users = {};

app.use(express.static('public'));
app.use(bodyParser.urlencoded({ extended: true }));

app.use(session({
  secret: 'your-secret-key',
  resave: false,
  saveUninitialized: false
}));

// Serve the login page if not logged in
app.get('/', (req, res) => {
  if (req.session.user) {
    res.send(`<h2>Welcome, ${req.session.user}!</h2><a href="/logout">Logout</a>`);
  } else {
    res.sendFile(path.join(__dirname, 'public', 'index.html'));
  }
});

// Registration route
app.post('/register', async (req, res) => {
  const { email, password } = req.body;
  if (users[email]) return res.send('⚠️ User already exists. Try logging in.');

  const hashedPassword = await bcrypt.hash(password, 10);
  users[email] = hashedPassword;

  // After successful registration, redirect to the login page (index.html)
  res.redirect('/');
});

// Login route
app.post('/login', async (req, res) => {
  const { email, password } = req.body;
  const hashedPassword = users[email];

  if (!hashedPassword) return res.send('❌ User not found.');

  const match = await bcrypt.compare(password, hashedPassword);
  if (match) {
    req.session.user = email;

    // After successful login, redirect to the home page (index.html)
    res.redirect('/');
  } else {
    res.send('❌ Incorrect password.');
  }
});

// Logout route
app.get('/logout', (req, res) => {
  req.session.destroy(() => {
    res.redirect('/');
  });
});

app.listen(PORT, () => {
  console.log(`🚀 Server running at http://localhost:${PORT}`);
});
